{
  "name": "bootstra-themes",
  "private": true,
  "description": "Bootstra Themes: a Bootstrap 5 theme collection, one npm package per theme.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloschinsky/bootstra-themes.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present && node --test scripts/release.test.mjs",
    "dev": "npm run dev --workspace bootstra-html32",
    "preview": "npm run build && npm run serve --workspace bootstra-showcase"
  },
  "engines": {
    "node": ">=20"
  }
}
