{
  "name": "bootstra-themes",
  "private": true,
  "description": "A collection of Bootstrap 5 themes, one npm package per theme.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev": "npm run dev --workspace bootstra-html32"
  },
  "engines": {
    "node": ">=20"
  }
}
