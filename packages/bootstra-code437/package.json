{
  "name": "bootstra-code437",
  "version": "0.1.0",
  "description": "A Bootstrap 5 theme inspired by ANSI art, BBS interfaces, DOS-era terminals, and IBM Code Page 437.",
  "themeCollection": {
    "id": "bootstra-code437",
    "name": "Code437",
    "description": "ANSI art, BBS boards and DOS-era terminals: textmode frames, bracketed buttons, dot leaders, per-section accents.",
    "demo": "_site",
    "preview": "docs/blog-desktop.png"
  },
  "style": "dist/code437.css",
  "main": "dist/code437.css",
  "files": ["dist", "src", "README.md", "LICENSE"],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "stylelint \"src/**/*.css\"",
    "test": "npm run lint && npm run build",
    "start": "npx --yes serve ."
  },
  "keywords": ["bootstrap", "bootstrap5", "theme", "css", "ansi", "bbs", "dos", "terminal", "cp437", "textmode", "retro"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloschinsky/bootstra-html32.git",
    "directory": "packages/bootstra-code437"
  },
  "homepage": "https://bloschinsky.github.io/bootstra-html32/themes/bootstra-code437/",
  "bugs": {
    "url": "https://github.com/bloschinsky/bootstra-html32/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": { "bootstrap": "^5.3.0" },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0"
  }
}
