{
  "name": "bootstra-p31",
  "version": "1.0.0",
  "description": "bootstra-p31 — a retro research-terminal (P31 phosphor CRT) theme for Bootstrap 5.3",
  "themeCollection": {
    "id": "bootstra-p31",
    "name": "P31",
    "description": "A research terminal on a P31 phosphor CRT: monospaced type, square corners, scanlines, green, amber or cyan phosphor.",
    "demo": "docs",
    "preview": "screenshots/screenshot.jpg"
  },
  "keywords": [
    "bootstrap",
    "bootstrap5",
    "theme",
    "retro",
    "terminal",
    "crt",
    "phosphor",
    "design-system"
  ],
  "author": "Artem Bloschinsky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloschinsky/bootstra-themes.git",
    "directory": "packages/bootstra-p31"
  },
  "homepage": "https://bloschinsky.github.io/bootstra-themes/themes/bootstra-p31/",
  "bugs": {
    "url": "https://github.com/bloschinsky/bootstra-themes/issues"
  },
  "style": "dist/bootstra-p31.css",
  "main": "dist/bootstra-p31.css",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.0"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "serve": "npx --yes serve .",
    "lint": "stylelint \"src/**/*.css\"",
    "test": "npm run lint && npm run build"
  }
}
